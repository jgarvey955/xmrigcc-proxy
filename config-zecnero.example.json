{
    "autosave": false,
    "background": false,
    "colors": true,
    "donate-level": 0,
    "donate-over-proxy": false,
    "mode": "nicehash",
    "bind": [{"host": "127.0.0.1", "port": 3333, "tls": false}],
    "pools": [{
        "algo": "rx/zecnero",
        "url": "127.0.0.1:18732",
        "user": "x",
        "daemon": true,
        "daemon-cookie-file": "/absolute/path/to/testnet/.cookie",
        "daemon-poll-interval": 1000,
        "daemon-job-timeout": 15000
    }],
    "retries": 2,
    "retry-pause": 1,
    "verbose": true,
    "watch": false
}
